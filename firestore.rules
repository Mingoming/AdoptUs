rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // PERBAIKAN: Izinkan semua pengguna yang login membaca profil pengguna lain
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.role == 'user';
      allow update: if isOwner(userId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.role == resource.data.role;
      allow delete: if false;

      // PERBAIKAN: Izinkan pengguna mengelola subkoleksi postingan yang mereka sukai
      match /likedPosts/{postId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && (
          // Kasus 1: Pemilik mengubah detail post miliknya
          (resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId)
          ||
          // Kasus 2: Pengguna lain memperbarui likesCount pada post (saat toggle like)
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']))
        );
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      // PERBAIKAN: Izinkan pengguna mencatat/menghapus like mereka pada post
      match /likes/{userId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }
    }
    
    match /adoptions/{adoptionId} {
      allow create: if request.auth != null
        && request.resource.data.adopterId == request.auth.uid
        && request.resource.data.ownerId != request.auth.uid
        && request.resource.data.status == "pending";

      allow read: if request.auth != null
        && (
          resource.data.adopterId == request.auth.uid ||
          resource.data.ownerId == request.auth.uid
        );

      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.status in ["approved", "rejected"];

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
