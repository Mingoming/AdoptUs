<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Base.Theme.AdoptUs" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorSecondaryContainer">@color/highlight_orange</item>

    </style>

    <style name="Theme.AdoptUs" parent="Base.Theme.AdoptUs" />



    <!-- Splash Screen Theme -->
    <style name="Theme.AdoptUs.Splash" parent="Theme.SplashScreen">

        <!-- Background -->
        <item name="windowSplashScreenBackground">@color/app_background</item>

        <!-- Logo (Dibuat transparan agar tidak double intro dengan custom animation) -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>

        <!-- Theme setelah splash -->
        <item name="postSplashScreenTheme">@style/Theme.AdoptUs</item>

    </style>

    <!-- UCrop Theme with FitsSystemWindows for Safe Area -->
    <style name="Theme.AdoptUs.UCrop" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fitsSystemWindows">true</item>
        <item name="colorPrimary">#E8693A</item>
        <item name="colorPrimaryDark">#D05629</item>
        <item name="colorAccent">#E8693A</item>
    </style>

</resources>