<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Media: Foto -->
    <ImageView
        android:id="@+id/ivMedia"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="visible" />

    <!-- Media: Video -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/pvVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:use_controller="false"
        app:resize_mode="fill" />

    <ImageView
        android:id="@+id/imgVideoIndicator"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:contentDescription="Video"
        android:src="@drawable/ic_play"
        android:visibility="gone" />

    <!-- Gradient overlay bawah agar teks terbaca -->
    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_feed_bottom" />

    <!-- Konten info hewan — pojok kiri bawah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="80dp"
        android:paddingBottom="32dp">

        <!-- Badge status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_status_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="8dp" />

        <!-- Nama hewan -->
        <TextView
            android:id="@+id/tvPetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mochi"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp" />

        <!-- Breed + usia -->
        <TextView
            android:id="@+id/tvBreedAge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Persian · 3 Months"
            android:textSize="14sp"
            android:textColor="#E0E0E0"
            android:layout_marginBottom="6dp" />

        <!-- Lokasi -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_location"
                app:tint="#E0E0E0" />

            <TextView
                android:id="@+id/tvCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mataram"
                android:textSize="13sp"
                android:textColor="#E0E0E0"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Tombol aksi -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Tombol Apply Adopsi -->
            <TextView
                android:id="@+id/btnApply"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Apply Adoption"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_apply"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:layout_marginEnd="8dp" />

            <!-- Tombol WhatsApp -->
            <TextView
                android:id="@+id/btnWhatsapp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="WA"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_whatsapp"
                android:gravity="center" />

        </LinearLayout>
    </LinearLayout>

    <!-- Panel kanan: Like + username owner -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingEnd="16dp"
        android:paddingBottom="40dp">

        <!-- Avatar owner -->
        <ImageView
            android:id="@+id/ivOwnerAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_avatar_circle"
            android:layout_marginBottom="16dp" />

        <!-- Like button -->
        <ImageView
            android:id="@+id/btnLike"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_heart"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvLikesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Detail button -->
        <ImageView
            android:id="@+id/btnDetail"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_info"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detail"
            android:textSize="12sp"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- Top safe area, so controls do not overlap the status bar. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <!-- Gratis / Fee badge pojok kanan atas -->
        <TextView
            android:id="@+id/tvFee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:text="FREE"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_fee_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </FrameLayout>

</FrameLayout>
